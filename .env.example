# Application
APP_ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Публичный URL сайта (без /api). На сервере — IP или домен.
SITE_ADDRESS=:80
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP
PUBLIC_SITE_URL=http://YOUR_SERVER_IP:8080
# Для SEO (canonical, sitemap, Open Graph) — тот же URL, что в браузере (часто :8080)
NEXT_PUBLIC_SITE_URL=http://YOUR_SERVER_IP:8080
CORS_ORIGINS=http://YOUR_SERVER_IP,http://localhost:3000

# Исходящая почта (кнопка «Отправить письмо»)
# Тест без ящика (Docker Mailpit):
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_SSL=false
SMTP_STARTTLS=false
SMTP_ALLOW_UNAUTHENTICATED=true
SMTP_FROM=site-audit@test.local
MAILPIT_PUBLIC_URL=http://YOUR_SERVER_IP:8081
# Бой (Яндекс и т.д.): замените SMTP_* и SMTP_ALLOW_UNAUTHENTICATED=false
SMTP_USER=
SMTP_PASSWORD=

# Браузерный fallback для антибот/SPA (Chromium в Docker backend)
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_MAX_FETCHES=14

# Глубина скана (сек / страниц). На проде эти ключи могут отсутствовать — тогда дефолты из backend/app/config.py
SCAN_TIME_BUDGET_SEC=600
SCAN_MAX_PAGES=30

# Nuclei в каждом скане (exposure/misconfig/cve, лимит NUCLEI_TIMEOUT_SEC)
NUCLEI_ENABLED=true
NUCLEI_TIMEOUT_SEC=120
PASSIVE_PROBE_MAX=12

# PostgreSQL — локально, облако (Neon/Supabase) или docker compose (опционально)
# Для облака часто нужен ?sslmode=require в конце строки
DATABASE_URL=postgresql+asyncpg://site_audit:change_me@localhost:5432/site_audit
POSTGRES_DB=site_audit
POSTGRES_USER=site_audit
POSTGRES_PASSWORD=change_me

# GigaChat (используется с шага 6)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-Pro
GIGACHAT_VERIFY_SSL_CERTS=true

# YooKassa (используется с шага 8)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=http://localhost:3000/reports
