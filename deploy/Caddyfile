# Замените {$SITE_ADDRESS} в .env на IP или домен (например audit.example.ru)
{$SITE_ADDRESS} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /docs* {
		reverse_proxy backend:8000
	}

	handle /openapi.json {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}